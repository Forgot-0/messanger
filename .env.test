# Config for the automated test suite (CI copies this to .env before pytest).
# All values are throwaway — infra hosts are overridden at runtime by the
# testcontainers fixtures in tests/conftest.py.
ENVIRONMENT=testing
PROJECT_NAME="Messanger"
DOMAIN=test.local
HOST=127.0.0.1
PORT=8000

BACKEND_CORS_ORIGINS=""
SECRET_KEY=test-secret-key
RATE_LIMITER_ENABLED=True
API_V1_STR=/api/v1

POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=test
POSTGRES_USER=test
POSTGRES_PASSWORD=test
SQL_ECHO=False

REDIS_HOST=localhost
REDIS_PORT=6379

SMTP_TLS=False
SMTP_SSL=False
SMTP_PORT=
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
EMAIL_SENDER_NAME=Test
EMAIL_SENDER_ADDRESS=test@test.local

QUEUE_REDIS_BROKER_URL="redis://localhost:6379/1"
QUEUE_REDIS_RESULT_BACKEND="redis://localhost:6379/1"

BROKER_URL=localhost:9092
GROUP_ID=test

LOG_LEVEL=WARNING
LOG_HANDLERS=stream

STORAGE_HOST=localhost
STORAGE_PORT=9000
STORAGE_ACCESS_KEY=test
STORAGE_SECRET_KEY=test123
STORAGE_PUBLIC_URL=http://localhost:9000

USER_REGISTRATION_ALLOWED=True

JWT_SECRET_KEY=test-jwt-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
EMAIL_RESET_TOKEN_EXPIRE_MINUTES=15

OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GOOGLE_REDIRECT_URI=http://test.local/api/v1/auth/oauth/google/callback
OAUTH_YANDEX_CLIENT_ID=
OAUTH_YANDEX_CLIENT_SECRET=
OAUTH_YANDEX_REDIRECT_URI=http://test.local/api/v1/auth/oauth/yandex/callback
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_GITHUB_REDIRECT_URI=http://test.local/api/v1/auth/oauth/github/callback

GRAFANA_USER=admin
GRAFANA_PASSWORD=test
