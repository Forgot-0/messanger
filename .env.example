# ─── Environment ─────────────────────────────────────────────────────────────
# local | production | testing
ENVIRONMENT=production
PROJECT_NAME=""
DOMAIN=example.com
HOST=0.0.0.0
PORT=8000

# ─── API ─────────────────────────────────────────────────────────────────────
BACKEND_CORS_ORIGINS=""
SECRET_KEY=
RATE_LIMITER_ENABLED=True
API_V1_STR=/api/v1

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_DB=app
POSTGRES_USER=user
POSTGRES_PASSWORD=password
SQL_ECHO=False

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379

# ─── Email ───────────────────────────────────────────────────────────────────
SMTP_TLS=False
SMTP_SSL=False
SMTP_PORT=
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
EMAIL_SENDER_NAME=
EMAIL_SENDER_ADDRESS=

# ─── Task queue (taskiq + Redis broker) ──────────────────────────────────────
QUEUE_REDIS_BROKER_URL="redis://redis:6379/1"
QUEUE_REDIS_RESULT_BACKEND="redis://redis:6379/1"

# ─── Kafka ───────────────────────────────────────────────────────────────────
BROKER_URL=kafka:9092
GROUP_ID=

# ─── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=WARNING
LOG_HANDLERS=file

# ─── SeaweedFS / S3 storage ───────────────────────────────────────────────────
# STORAGE_HOST/PORT is the S3 gateway the backend talks to inside app-network.
# STORAGE_PUBLIC_URL is the host clients resolve; presigned URLs are signed for it.
# A bare host is prefixed with a scheme from STORAGE_SECURE / STORAGE_PUBLIC_SECURE,
# a value that already carries http:// or https:// is used as is.
STORAGE_HOST=seaweedfs
STORAGE_PORT=8333
STORAGE_ACCESS_KEY=seaweed
STORAGE_SECRET_KEY=seaweed123
STORAGE_PUBLIC_URL=https://storage.example.com
STORAGE_REGION=us-east-1
STORAGE_SECURE=False
STORAGE_PUBLIC_SECURE=True

STORAGE_SSE=False
SEAWEEDFS_VOLUME_SIZE_LIMIT_MB=1024
SEAWEEDFS_CORS_ORIGINS=*


# ─── Auth ────────────────────────────────────────────────────────────────────
USER_REGISTRATION_ALLOWED=False

JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
EMAIL_RESET_TOKEN_EXPIRE_MINUTES=15

OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GOOGLE_REDIRECT_URI=https://api.example.com/api/v1/auth/oauth/google/callback

OAUTH_YANDEX_CLIENT_ID=
OAUTH_YANDEX_CLIENT_SECRET=
OAUTH_YANDEX_REDIRECT_URI=https://api.example.com/api/v1/auth/oauth/yandex/callback

OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_GITHUB_REDIRECT_URI=https://api.example.com/api/v1/auth/oauth/github/callback

# ─── Profiles / contacts ─────────────────────────────────────────────────────
CONTACT_IDENTIFIER_PEPPER=

# ─── Monitoring ──────────────────────────────────────────────────────────────
GRAFANA_USER=admin
GRAFANA_PASSWORD=changeme
GRAFANA_BIND_HOST=127.0.0.1
